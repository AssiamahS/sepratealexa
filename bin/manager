#!/usr/bin/env python3
"""manager — your daily brief.

  manager today          today's tasks
  manager done <id>      check a task off
  manager add "task"     add a task for today
"""

import json
import sys
from datetime import date
from pathlib import Path

VERSION = "0.1.0"
TASKS = Path(__file__).resolve().parent.parent / "tasks.json"

PRIO_ORDER = {"high": 0, "med": 1, "low": 2}
PRIO_MARK = {"high": "!!", "med": " !", "low": "  "}


def load():
    return json.loads(TASKS.read_text())


def save(data):
    TASKS.write_text(json.dumps(data, indent=2) + "\n")


def cmd_today():
    data = load()
    print(f"Manager brief — {data['date']}"
          + ("  (stale — run ./run_brief.sh)" if data["date"] != date.today().isoformat() else ""))
    print()
    tasks = sorted(data["tasks"], key=lambda t: (t["done"], PRIO_ORDER.get(t["priority"], 3)))
    for t in tasks:
        box = "✓" if t["done"] else " "
        print(f" [{box}] {PRIO_MARK.get(t['priority'], '  ')} #{t['id']} [{t['area']}] {t['task']}")
        print(f"          → {t['why']}")
    left = sum(1 for t in data["tasks"] if not t["done"])
    print(f"\n{left} open / {len(data['tasks'])} total")


def cmd_done(task_id):
    data = load()
    for t in data["tasks"]:
        if t["id"] == task_id:
            t["done"] = True
            save(data)
            print(f"✓ done: {t['task']}")
            return
    sys.exit(f"no task #{task_id}")


def cmd_add(text):
    data = load()
    next_id = max((t["id"] for t in data["tasks"]), default=0) + 1
    data["tasks"].append({"id": next_id, "priority": "med", "area": "adhoc",
                          "task": text, "why": "added by you", "done": False})
    save(data)
    print(f"added #{next_id}: {text}")


def main():
    args = sys.argv[1:]
    cmd = args[0] if args else "today"
    if cmd == "today":
        cmd_today()
    elif cmd == "done" and len(args) > 1:
        cmd_done(int(args[1]))
    elif cmd == "add" and len(args) > 1:
        cmd_add(" ".join(args[1:]))
    elif cmd == "version":
        print(f"manager {VERSION}")
    else:
        sys.exit(__doc__.strip())


if __name__ == "__main__":
    main()
