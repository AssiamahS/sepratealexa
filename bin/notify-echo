#!/bin/zsh
# Push a notification to the Echo Show via the Notify Me skill.
#   notify-echo "message"            one-off
#   echo "msg" | notify-echo         from a pipe
# Setup (one time): enable "Notify Me" skill in the Alexa app, say
# "Alexa, open Notify Me", paste the emailed access code into ~/.notifyme_code
set -e

CODE_FILE="$HOME/.notifyme_code"
[ -r "$CODE_FILE" ] || { echo "notify-echo: missing $CODE_FILE — enable the Notify Me skill, say 'Alexa, open Notify Me', save the emailed code there" >&2; exit 1; }
CODE=$(tr -d '[:space:]' < "$CODE_FILE")

MSG="${1:-$(cat)}"
[ -n "$MSG" ] || { echo "notify-echo: empty message" >&2; exit 1; }

HTTP=$(curl -sS -o /tmp/notify-echo-resp.txt -w '%{http_code}' \
  -X POST https://api.notifymyecho.com/v1/NotifyMe \
  -H 'Content-Type: application/json' \
  --data "$(python3 -c "import json,sys; print(json.dumps({'notification': sys.argv[1], 'accessCode': sys.argv[2]}))" "$MSG" "$CODE")")

if [ "$HTTP" = "200" ]; then
  echo "sent: $MSG"
else
  echo "notify-echo: HTTP $HTTP — $(cat /tmp/notify-echo-resp.txt)" >&2
  exit 1
fi
